entrypoint = "main.py"
modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["SDL2", "SDL2_image", "SDL2_mixer", "SDL2_ttf", "fontconfig", "freetype", "libjpeg", "libpng", "pkg-config", "portmidi"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["sh", "-c", "Xvfb :0 -screen 0 1024x768x24 & DISPLAY=:0 python3 main.py & websockify --web /nix/store/*-novnc-*/share/novnc 8080 localhost:5900"]
deploymentTarget = "cloudrun"

[agent]
expertMode = true
